generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  /// CNPJ digits only (14). Must be valid + active at registration.
  cnpj      String   @unique
  /// Commission Voltou takes on paid checkouts (basis points). 500 = 5%.
  commissionRateBps Int @default(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores              Store[]
  users               User[]
  products            Product[]
  customers           Customer[]
  sales               Sale[]
  campaigns           Campaign[]
  outreachMessages    OutreachMessage[]
  storeKnowledge      StoreKnowledge[]
  whatsappConnections WhatsAppConnection[]
  customerInterests   CustomerInterest[]
  checkouts           Checkout[]
  customerEvents      CustomerEvent[]
  importJobs          ImportJob[]
  blingConnections    BlingConnection[]
  mercadoPagoConnections MercadoPagoConnection[]
}

model Store {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  /// Globally unique public path segment for /loja/:storeSlug/:coupon
  slug      String   @unique
  timezone  String   @default("America/Sao_Paulo")
  /// mercadopago | infinitepay (futuro) | stub
  preferredCheckoutProvider String @default("mercadopago")
  checkoutLogoUrl          String?
  checkoutPrimaryColor     String?
  checkoutSecondaryColor   String?
  /// geist | dm-sans | space-grotesk | nunito | playfair | source-serif
  checkoutFontFamily       String?
  checkoutMessage          String?
  /// Public /loja: offer delivery vs pickup-only
  deliveryEnabled          Boolean  @default(true)
  /// Fixed shipping in cents (0 = free). Commission excludes this.
  shippingCents            Int      @default(0)
  /// Pickup address/hours shown on /loja
  pickupAddressText        String?
  /// WhatsApp for order alerts (not the WAHA sales session)
  orderNotifyPhoneE164     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products            Product[]
  customers           Customer[]
  sales               Sale[]
  campaigns           Campaign[]
  outreachMessages    OutreachMessage[]
  storeKnowledge      StoreKnowledge[]
  whatsappConnections WhatsAppConnection[]
  customerInterests   CustomerInterest[]
  checkouts           Checkout[]
  customerEvents      CustomerEvent[]
  importJobs          ImportJob[]
  blingConnections    BlingConnection[]
  mercadoPagoConnections MercadoPagoConnection[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model User {
  id                   String    @id @default(uuid())
  tenantId             String
  ownerName            String
  email                String    @unique
  passwordHash         String
  /// Lojista WhatsApp identity (BR mobile E.164). Unique; required at owner signup.
  ownerPhoneE164       String?   @unique
  /// Google subject (sub) when the owner signed in with Google.
  googleSub            String?   @unique
  role                 String    @default("owner")
  emailVerifiedAt      DateTime?
  emailVerifyToken     String?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([emailVerifyToken])
  @@index([passwordResetToken])
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String
  storeId     String
  name        String
  sku         String?
  /// ID do produto no Bling (quando sincronizado)
  blingProductId String?
  category    String?
  priceCents  Int
  /// Custo do produto (opcional) — usado no piso de preço da IA
  costCents   Int?
  /// Desconto máximo permitido pelo lojista (basis points; 1000 = 10%)
  maxDiscountBps Int?
  /// available | unavailable — estoque numérico continua opcional
  availability String  @default("available")
  /// A IA pode oferecer este produto?
  sellableByAi Boolean @default(true)
  stock       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store             Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sales             Sale[]
  customerInterests CustomerInterest[]
  checkouts         Checkout[]

  @@index([tenantId, storeId])
  @@index([tenantId, storeId, blingProductId])
  @@index([tenantId, storeId, sku])
}

model Customer {
  id          String   @id @default(uuid())
  tenantId    String
  storeId     String
  displayName String
  /// PII: store phone as HMAC/hash + encrypted blob at application layer
  phoneHash   String
  /// PII: encrypted E.164 — decrypt only in trusted services
  phoneEnc    String?
  /// Masked display only (never full plaintext in UI logs)
  phoneMasked String?
  notes       String?
  /// LGPD: cliente pediu para não receber mensagens (respeitado em qualquer disparo)
  optedOutAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store             Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sales             Sale[]
  outreachMessages  OutreachMessage[]
  customerInterests CustomerInterest[]
  checkouts         Checkout[]
  customerEvents    CustomerEvent[]

  @@index([tenantId, storeId])
  @@index([phoneHash])
}

/// What the end-customer showed interest in — critical for recovery & AI upsell.
model CustomerInterest {
  id                  String   @id @default(uuid())
  tenantId            String
  storeId             String
  customerId          String
  productId           String?
  /// Snapshot so history survives product edits/deletes
  productNameSnapshot String
  productPriceCents   Int?
  source              String   @default("walk_in") // walk_in | whatsapp | import | ai | web
  status              String   @default("open") // open | converted | discarded
  notes               String?
  interestedAt        DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([tenantId, storeId, customerId])
  @@index([tenantId, status])
  @@index([productId])
}

model Sale {
  id              String   @id @default(uuid())
  tenantId        String
  storeId         String
  customerId      String
  productId       String
  amountCents     Int
  currency        String   @default("BRL")
  /// in_store | checkout_link | ai | import
  source          String   @default("in_store")
  status          String   @default("completed") // completed | pending | refunded
  checkoutId      String?
  /// Voltou commission in cents (0 for pure in-store unless configured otherwise)
  commissionCents Int      @default(0)
  commissionRateBps Int    @default(0)
  /// Mercado Pago payment id (audit)
  mpPaymentId     String?
  soldAt          DateTime @default(now())
  createdAt       DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  checkout Checkout? @relation(fields: [checkoutId], references: [id], onDelete: SetNull)

  @@index([tenantId, storeId, soldAt])
  @@index([customerId])
  @@index([mpPaymentId])
  @@index([checkoutId])
}

/// Payment link the AI (or lojista) sends to the end-customer.
model Checkout {
  id                String    @id @default(uuid())
  tenantId          String
  storeId           String
  customerId        String
  productId         String?
  productNameSnapshot String
  amountCents       Int
  currency          String    @default("BRL")
  status            String    @default("pending") // pending | paid | expired | cancelled
  /// Public URL sent on WhatsApp (/loja/{slug}/{coupon})
  paymentUrl        String
  /// Provider: stub | mercadopago | infinitepay
  provider          String    @default("stub")
  /// Public token (also used as legacy /p/{token} alias)
  externalId        String?
  /// Friendly coupon code (UPPERCASE), unique per store
  couponCode        String?
  /// Original list price before discount ("De R$")
  listPriceCents    Int?
  /// Store discount in basis points (1000 = 10%)
  discountBps       Int       @default(0)
  clickedAt         DateTime?
  clickCount        Int       @default(0)
  outreachMessageId String?
  /// Mercado Pago payment id once paid
  mpPaymentId       String?
  /// Provider preference/payment id (ex.: MP preference id)
  providerRef       String?
  /// Redirect URL for the actual PSP checkout (init_point)
  providerInitPoint String?
  commissionRateBps Int
  commissionCents   Int       @default(0)
  interestId        String?
  createdBy         String    @default("human") // human | ai
  /// Staff user id from JWT `sub`. Never taken from the client body.
  staffUserId       String?
  paidAt            DateTime?
  expiresAt         DateTime?
  /// Quando o lembrete de checkout pendente foi gerado (evita duplicar)
  reminderAt        DateTime?
  addonsJson        String?
  paidLinesJson     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  sales    Sale[]

  @@unique([storeId, couponCode])
  @@index([tenantId, storeId, status])
  @@index([customerId])
  @@index([externalId])
  @@index([providerRef])
  @@index([couponCode])
}

/// Raw PSP webhook payloads for audit / replay.
model WebhookLog {
  id          String   @id @default(uuid())
  provider    String   // mercadopago
  payload     String   // JSON
  headers     String?  // JSON
  receivedAt  DateTime @default(now())
  processedOk Boolean  @default(false)
  error       String?
}

/// Timeline feed for the customer profile (purchases, interests, outreach, checkouts).
model CustomerEvent {
  id         String   @id @default(uuid())
  tenantId   String
  storeId    String
  customerId String
  /// sale | interest | outreach | checkout_sent | checkout_paid | reply | note | contacted
  type       String
  title      String
  detail     String?
  metadata   String? // JSON string
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId, occurredAt])
}

model Campaign {
  id        String   @id @default(uuid())
  tenantId  String
  storeId   String
  name      String
  /// draft | awaiting_approval | active | done | system
  status    String   @default("draft")
  /// Segmento alvo: inativos_60d | interesse_aberto | checkout_pendente | sem_compra | todos
  segment   String?
  /// Template com {{nome}} e {{produto}}
  messageTemplate String?
  /// system = criada automaticamente (ex.: lembrete de checkout)
  kind      String   @default("manual")
  scheduledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  outreachMessages OutreachMessage[]

  @@index([tenantId, storeId])
}

model OutreachMessage {
  id         String    @id @default(uuid())
  tenantId   String
  storeId    String
  campaignId String
  customerId String
  channel    String    @default("whatsapp")
  body       String
  /// pending_approval | approved | rejected | sent | failed
  status     String    @default("pending_approval")
  failReason String?
  /// chatId WAHA usado no envio (@c.us ou @lid) — para casar respostas
  externalChatId String?
  /// ID da mensagem no provedor (WAHA)
  providerMessageId String?
  approvedAt DateTime?
  sentAt     DateTime?
  repliedAt  DateTime?
  replyPreview String?
  createdAt  DateTime  @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([tenantId, storeId, status])
  @@index([externalChatId])
}

model StoreKnowledge {
  id         String   @id @default(uuid())
  tenantId   String
  storeId    String
  title      String
  content    String
  chunkIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store  Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([tenantId, storeId])
}

/// Importação "jogue aqui": planilha/XML NF-e vira prévia estruturada, depois commit.
model ImportJob {
  id             String    @id @default(uuid())
  tenantId       String
  storeId        String
  /// csv | nfe_xml | text | mixed
  sourceType     String
  /// preview | committed | failed
  status         String    @default("preview")
  fileName       String?
  /// JSON ImportPreview (customers/products/sales/warnings)
  payload        String
  customersCount Int       @default(0)
  productsCount  Int       @default(0)
  salesCount     Int       @default(0)
  /// JSON string[] de erros
  errors         String?
  committedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store  Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([tenantId, storeId, createdAt])
}

model WhatsAppConnection {
  id           String   @id @default(uuid())
  tenantId     String
  storeId      String
  /// Apelido exibido no painel
  label        String
  /// Nome da sessão no WAHA (id técnico)
  sessionName  String
  provider     String   @default("waha")
  /// STOPPED | STARTING | SCAN_QR_CODE | WORKING | FAILED
  status       String   @default("STARTING")
  phoneE164    String?
  /// Metadata JSON (legado BSP / extras)
  metadataEnc  String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store  Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([sessionName])
  @@index([tenantId, storeId])
}

/// Conexão OAuth do Bling (1 por loja) — catálogo e estoque.
model BlingConnection {
  id              String    @id @default(uuid())
  tenantId        String
  storeId         String
  /// AES-GCM (mesmo padrão do telefone)
  accessTokenEnc  String
  refreshTokenEnc String
  expiresAt       DateTime
  /// connected | expired | disconnected
  status          String    @default("connected")
  accountLabel    String?
  lastSyncAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store  Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, storeId])
  @@index([tenantId, storeId])
}

/// Conexão OAuth Mercado Pago Marketplace (1 por loja) — split de comissão.
model MercadoPagoConnection {
  id              String    @id @default(uuid())
  tenantId        String
  storeId         String
  accessTokenEnc  String
  refreshTokenEnc String
  expiresAt       DateTime
  /// connected | expired | disconnected
  status          String    @default("connected")
  mpUserId        String?
  accountLabel    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store  Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, storeId])
  @@index([tenantId, storeId])
}
