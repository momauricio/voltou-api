DATABASE_URL="file:./dev.db"
PORT=3001
WEB_URL=http://localhost:3000
# AUTH_SECRET is required at boot (min 32 chars). Missing, blank, short
# placeholders, and the old public default voltou-dev-secret-change-me are
# refused (process will not start). Generate one: openssl rand -base64 48
AUTH_SECRET=
# If PII/OAuth data was encrypted with AUTH_SECRET (no PII_SECRET set), copy
# the current AUTH_SECRET into PII_SECRET before generating a new AUTH_SECRET.
NODE_ENV=development

# Google Sign-In (lojista). Sem este valor, POST /auth/google responde 503.
# Use o Client ID OAuth Web do Google Cloud — não invente um valor.
GOOGLE_CLIENT_ID=

# Resend (https://resend.com) — emails de verificação e reset
RESEND_API_KEY=
RESEND_FROM="Voltou. <onboarding@resend.dev>"

# WAHA — WhatsApp HTTP API (https://waha.devlike.pro/)
# Suba com: docker compose -f docker-compose.waha.yml up -d
WAHA_BASE_URL=http://localhost:3002
WAHA_API_KEY=00000000000000000000000000000000
# HMAC-SHA512 for POST /whatsapp/webhook (WAHA X-Webhook-Hmac).
# Required in production. Same value as WAHA hmac.key / WHATSAPP_HOOK_HMAC_KEY.
# Do not invent a committed value.
WHATSAPP_HOOK_HMAC_KEY=

# Bling API v3 (OAuth) — https://developer.bling.com.br
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REDIRECT_URI=http://localhost:3000/painel/produtos/bling/callback

# Mercado Pago Marketplace (split) — https://www.mercadopago.com.br/developers
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=http://localhost:3000/painel/perfil/mercadopago/callback
# Required. Unsigned Mercado Pago notifications are refused if empty.
# Copy the webhook secret from the MP dashboard — do not invent a value.
MP_WEBHOOK_SECRET=
# URL pública da API para webhooks (em prod: https://api.seudominio.com)
API_PUBLIC_URL=http://localhost:3001
# 1 = forçar sandbox_init_point
MP_USE_SANDBOX=1

# ---- Importação com LLM — Grok (xAI) ----
# Ver src/imports/AI_IMPORT.md
# Com enabled=1 + API key, planilhas ambíguas são reclassificadas automaticamente.
IMPORT_AI_ENABLED=0
# IMPORT_AI_API_KEY=xai-...
# XAI_API_KEY=
IMPORT_AI_BASE_URL=https://api.x.ai/v1
IMPORT_AI_MODEL=grok-3-mini
# IMPORT_AI_TIMEOUT_MS=25000
# IMPORT_AI_CONFIDENCE_THRESHOLD=0.65
